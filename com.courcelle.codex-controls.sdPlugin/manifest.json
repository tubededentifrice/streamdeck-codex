{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "Name": "Codex Controls",
  "Version": "0.1.0.0",
  "Author": "Vincent Courcelle",
  "Actions": [
    {
      "Name": "Model",
      "UUID": "com.courcelle.codex-controls.model",
      "Icon": "imgs/actions/model/icon",
      "Tooltip": "Set one model or cycle through configured models for the selected Codex task.",
      "PropertyInspectorPath": "ui/action.html",
      "Controllers": ["Keypad"],
      "States": [
        { "Image": "imgs/actions/model/key", "TitleAlignment": "middle" }
      ]
    },
    {
      "Name": "Thinking",
      "UUID": "com.courcelle.codex-controls.thinking",
      "Icon": "imgs/actions/thinking/icon",
      "Tooltip": "Set one thinking level or cycle through configured levels for the selected Codex task.",
      "PropertyInspectorPath": "ui/action.html",
      "Controllers": ["Keypad"],
      "States": [
        { "Image": "imgs/actions/thinking/key", "TitleAlignment": "middle" }
      ]
    },
    {
      "Name": "Preset",
      "UUID": "com.courcelle.codex-controls.preset",
      "Icon": "imgs/actions/preset/icon",
      "Tooltip": "Set one model and thinking preset or cycle through configured presets for the selected Codex task.",
      "PropertyInspectorPath": "ui/action.html",
      "Controllers": ["Keypad"],
      "States": [
        { "Image": "imgs/actions/preset/key", "TitleAlignment": "middle" }
      ]
    },
    {
      "Name": "Single Preset",
      "UUID": "com.courcelle.codex-controls.single-preset",
      "Icon": "imgs/actions/single-preset/icon",
      "Tooltip": "Set one model and thinking preset for the selected Codex task. The key dims while the task uses other values.",
      "PropertyInspectorPath": "ui/action.html",
      "Controllers": ["Keypad"],
      "States": [
        {
          "Image": "imgs/actions/single-preset/key",
          "TitleAlignment": "middle"
        }
      ]
    },
    {
      "Name": "Shortcut",
      "UUID": "com.courcelle.codex-controls.shortcut",
      "Icon": "imgs/actions/shortcut/icon",
      "Tooltip": "Open Review, Terminal, Browser, Files, or Side chat in Codex.",
      "PropertyInspectorPath": "ui/action.html",
      "Controllers": ["Keypad"],
      "States": [
        {
          "Image": "imgs/actions/shortcut/key",
          "TitleAlignment": "middle"
        }
      ]
    }
  ],
  "Category": "Codex Controls",
  "CategoryIcon": "imgs/plugin/category-icon",
  "CodePath": "bin/plugin.js",
  "Description": "Change Codex task settings and open Codex panels from Stream Deck.",
  "Icon": "imgs/plugin/marketplace",
  "URL": "https://github.com/tubededentifrice/codex-streamdeck",
  "SupportURL": "https://github.com/tubededentifrice/codex-streamdeck/issues",
  "SDKVersion": 3,
  "Software": { "MinimumVersion": "7.1" },
  "OS": [{ "Platform": "mac", "MinimumVersion": "12" }],
  "Nodejs": { "Version": "24" },
  "UUID": "com.courcelle.codex-controls"
}
