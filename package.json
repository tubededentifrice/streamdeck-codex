{
  "name": "codex-streamdeck",
  "version": "0.1.0",
  "description": "Control selected Codex task settings and open Codex panels from Stream Deck.",
  "author": "Vincent Courcelle",
  "license": "MIT",
  "private": true,
  "homepage": "https://github.com/tubededentifrice/codex-streamdeck#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tubededentifrice/codex-streamdeck.git"
  },
  "bugs": {
    "url": "https://github.com/tubededentifrice/codex-streamdeck/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "rollup -c",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "generate:readme-images": "node --experimental-strip-types scripts/generate-publication-assets.mjs",
    "generate:publication-assets": "node --experimental-strip-types scripts/generate-publication-assets.mjs",
    "lint": "eslint .",
    "package:plugin": "node scripts/package-plugin.mjs",
    "smoke:codex": "CODEX_LIVE_TEST=1 vitest run tests/live-codex.test.ts",
    "test": "vitest run --maxWorkers=1",
    "typecheck": "tsc --noEmit",
    "validate": "streamdeck validate com.courcelle.codex-controls.sdPlugin --no-update-check",
    "watch": "rollup -c -w --watch.onEnd=\"streamdeck restart com.courcelle.codex-controls\""
  },
  "type": "module",
  "devDependencies": {
    "@elgato/cli": "^1.9.0",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-node-resolve": "^15.2.2",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.1.0",
    "@tsconfig/node20": "^20.1.2",
    "@types/node": "~24.1.0",
    "eslint": "^10.9.0",
    "prettier": "^3.9.6",
    "rollup": "^4.0.2",
    "tslib": "^2.6.2",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@elgato/streamdeck": "^2.1.2",
    "@elgato/utils": "^0.6.0"
  },
  "overrides": {
    "@elgato/utils": {
      "zod": "^4.6.6"
    }
  }
}
